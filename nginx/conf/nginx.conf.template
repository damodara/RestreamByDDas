load_module modules/ngx_rtmp_module.so;

user www-data;
# 1 воркер — иначе rtmp-соединения раскидываются по воркерам, и /stat
# каждого воркера видит только свою часть потоков (общая особенность nginx-rtmp).
worker_processes 1;
pid /run/nginx.pid;

# Два error_log сразу (поддерживается с nginx 1.5.2) — в stderr для
# "docker compose logs nginx", и вторым в файл на общем с Django volume
# (server_logs, см. docker-compose.yml), чтобы этот же лог можно было
# показать на сайте (crud:server_logs) без доступа к серверу. На этом
# уровне (info, не notice) уже видны события начала/конца
# RTMP-публикации — полезно при разборе "стрим остановлен, а /stat/сайт
# всё ещё показывают live". Файл открывает master-процесс (root, ещё до
# смены на www-data), поэтому пустая root:root-директория тома пишется
# без отдельного chmod — не тот случай, что у exec_publish/push.sh ниже.
error_log /dev/stderr info;
error_log /var/log/restream/nginx-error.log info;

# nginx по умолчанию обнуляет окружение воркеров — без этого push.sh/stop.sh
# не увидят DJANGO_HOOK_BASE_URL/RTMP_HOOK_SECRET.
env DJANGO_HOOK_BASE_URL;
env RTMP_HOOK_SECRET;

events {
    worker_connections 1024;
}

rtmp {
    server {
        listen 1935;
        chunk_size 4096;

        application live {
            live on;
            record off;

            on_publish ${DJANGO_HOOK_BASE_URL}/crud/rtmp-hooks/on-publish/?secret=${RTMP_HOOK_SECRET};
            exec_publish /rtmp-push/push.sh $name;
            exec_publish_done /rtmp-push/stop.sh $name;
        }
    }
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    server {
        listen 8080;

        location /stat {
            rtmp_stat all;
        }

        location /control {
            rtmp_control all;
        }
    }

    server {
        listen 80;

        location /static/ {
            alias /static/;
            # Без этого браузер может закэшировать статику эвристически
            # (по Last-Modified) и не подхватить новую версию CSS/JS после
            # деплоя — collectstatic хэши имён файлов не проставляет, пока
            # DEBUG=True (штатное поведение Django), так что кэш-бастинга
            # через URL нет и приходится явно требовать ревалидацию.
            add_header Cache-Control "no-cache";
        }

        location / {
            proxy_pass http://django:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
