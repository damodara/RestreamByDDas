SECRET_KEY=
# Ключ шифрования RTMP-ключей дестинаций at rest. Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
DEBUG=
ALLOWED_HOSTS=
#postgres
DB_NAME=
DB_USER=
DB_PASSWORD=
# DB_HOST для голого локального запуска (127.0.0.1); docker-compose
# переопределяет его на "db" сам, менять тут под compose не нужно.
DB_HOST=
DB_PORT=
#email (оставьте EMAIL_HOST пустым, чтобы письма печатались в консоль)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=
#rtmp
RTMP_SERVER_HOST=
RTMP_APP=
RTMP_HOOK_SECRET=
NGINX_STAT_URL=
NGINX_CONTROL_URL=
#srt
SRT_SERVER_HOST=
SRT_PORT=
# True только когда TLS реально терминируется (nginx/балансировщик) —
# включает secure cookies/HSTS/SSL-редирект. Раньше сломает логин.
USE_TLS=
